{
  "name": "crm",
  "version": "1.0.0",
  "description": "CRM System Monorepo",
  "private": true,
  "workspaces": [
    "src/server",
    "src/client"
  ],
  "scripts": {
    "start": "node src/server/app.js",
    "dev": "nodemon src/server/app.js",
    "build": "npm run build --workspace=src/client",
    "test": "jest --config jest.config.js --runInBand",
    "test:coverage": "jest --config jest.config.js --runInBand --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/server",
    "migrate": "knex --knexfile src/server/config/knexfile.js migrate:latest",
    "seed": "knex --knexfile src/server/config/knexfile.js seed:run",
    "update": "npm install && npm run migrate",
    "health-check": "curl -f http://localhost:${PORT:-3000}/health || exit 1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^7.0.13",
    "otplib": "^13.3.0",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint": "^9.39.3",
    "globals": "^17.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
