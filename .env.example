# Application
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# Database (individual variables are authoritative; install.sh uses these)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=crm_password
DB_SSL=false

# JWT
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-here
JWT_REFRESH_SECRET=your-very-long-and-secure-refresh-secret-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="CRM System <noreply@example.com>"

# Frontend
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS: comma-separated extra allowed origins (e.g. when behind a reverse proxy)
# CORS_ORIGINS=https://crm.example.com

# Logging
LOG_LEVEL=info
